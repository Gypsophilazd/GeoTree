# Set these as environment variables; do not store secrets here.
# WSL GEOTREE_RUN_ROOT=/mnt/d/GeoTree/.geotree
# Windows GEOTREE_SHARED_RUN_ROOT=D:\GeoTree\.geotree
# GEOTREE_PUBLIC_INSTRUCTION=/absolute/path/to/agent-visible/instruction.md
# GEOTREE_INSTRUCTION_SHA256=<sha256 of original public instruction bytes>
# GEOTREE_L_TRIAL=l-0123456789abcdef-l0
# GEOTREE_L_DEADLINE=<Unix deadline in seconds>
# Live only after explicit authorization and independent isolation checks:
# GEOTREE_L_RUN_APPROVED=EXPLICIT_PAIR_APPROVAL
# GEOTREE_SEPARATE_VERIFIER_CONFIRMED=YES
# Optional local smoke image overrides: GEOTREE_SMOKE_IMAGE, GEOTREE_HARBOR_SMOKE_IMAGE
